{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "komaawase",
	"compatibility_date": "2026-09-27",
	"compatibility_flags": [
		// worker-mailer needs nodejs_compat (which also covers AsyncLocalStorage)
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Sign-in mail goes out through the シンレンタルサーバー SMTP server.
	// The password is a secret: `npx wrangler secret put SMTP_PASSWORD`.
	"vars": {
		"SMTP_HOST": "sv3021.wpx.ne.jp",
		"SMTP_PORT": "465",
		"MAIL_FROM": "noreply@koma.tomakura.com"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "komaawase",
			"database_id": "693c8fe0-bd52-44a2-9307-567ad7c42be2",
			"migrations_dir": "drizzle"
		}
	],
	// Per-IP limits for endpoints anyone can call. Period must be 10 or 60 seconds.
	"ratelimits": [
		{
			"name": "PASSKEY_OPTIONS_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "EMAIL_LINK_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 }
		}
	]
}
