{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "komaawase",
	"compatibility_date": "2026-09-27",
	"compatibility_flags": [
		"nodejs_als"
	],
	// SvelteKit's worker, wrapped to also take the import queue and the daily cron. The adapter
	// reads svelte-kit.wrangler.jsonc instead, since it writes its worker to `main`.
	"main": "worker/entry.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Sign-in mail goes through relay/send.php on シンレンタルサーバー (Workers can't reach its SMTP).
	// Course files are kept there too, through relay/files.php.
	// The HMAC keys are secrets: `npx wrangler secret put RELAY_SECRET` and `FILES_SECRET`.
	"vars": {
		"RELAY_URL": "https://tomakura.com/koma-relay/send.php",
		"FILES_URL": "https://tomakura.com/koma-files/files.php"
	},
	// The app lives at koma.tomakura.com. Passkeys are bound to this hostname.
	"routes": [{ "pattern": "koma.tomakura.com", "custom_domain": true }],
	"workers_dev": false,
	// Preview versions would share the production D1 and secrets, and the mail relay only
	// accepts production sign-in links, so previews stay off.
	"preview_urls": false,
	// Lets Cloudflare run the Worker near D1 when it measures that pages come back sooner:
	// from Tokyo each query waited about 85ms, and a page makes two or three in a row.
	"placement": { "mode": "smart" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "komaawase",
			"database_id": "693c8fe0-bd52-44a2-9307-567ad7c42be2",
			"migrations_dir": "drizzle"
		}
	],
	// Screenshot imports: one at a time, so Groq's per-minute limits hold. Jobs live in D1
	// (import_jobs); a message only names one, and the daily cron re-sends what is due.
	"queues": {
		"producers": [{ "binding": "IMPORT_QUEUE", "queue": "koma-import" }],
		"consumers": [{ "queue": "koma-import", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 10, "max_concurrency": 1 }]
	},
	// 03:00 Japan time, after the AI quotas reset: retries, cleanup of old images and sessions
	"triggers": { "crons": ["0 18 * * *"] },
	// The backup reader for screenshots (Groq, keyed by the GROQ_API_KEY secret, comes first)
	"ai": { "binding": "AI", "remote": true },
	// Per-IP limits for endpoints anyone can call. Period must be 10 or 60 seconds.
	"ratelimits": [
		{
			"name": "PASSKEY_OPTIONS_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "EMAIL_LINK_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 }
		}
	]
}
