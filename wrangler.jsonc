{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "komaawase",
	"compatibility_date": "2026-09-27",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "komaawase",
			// Replace with the id printed by `wrangler d1 create komaawase` before deploying.
			// Local dev (`--local`) works with this placeholder.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle"
		}
	]
}
